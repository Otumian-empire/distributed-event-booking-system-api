# database (is shared at the moment)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=distributed_event_booking_system_api_db

# application settings
NODE_ENV=development
PASSWORD_HASHING_ROUNDS=10

# add app specific ports here
USER_PORT=3000
ADMIN_PORT=3001

# jwt settings
ISSUER=distributed_event_booking_system_api_db
AUDIENCE=distributed_event_booking_system_api_db

# user tokens
JWT_ACCESS_SECRET_USER=
JWT_ACCESS_TOKEN_TTL_USER=21600  #  60 * 60 * 6 (6 hours)

# admin tokens
JWT_ACCESS_SECRET_ADMIN=
JWT_ACCESS_TOKEN_TTL_ADMIN=21600 #  60 * 60 * 6 (6 hours)


# REDIS
REDIS_AUTH_URL=redis://localhost:6379

SMTP_HOST=
SMTP_SSL_PORT=587
NO_REPLY_SMTP_EMAIL=
NO_REPLY_SMTP_USERNAME=
NO_REPLY_SMTP_PASSWORD=

# testing url
TEST_WEB_HOOK_URL=

